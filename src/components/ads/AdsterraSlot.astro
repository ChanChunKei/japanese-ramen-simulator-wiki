---
/**
 * 每个固定尺寸广告使用独立 HTML 和 window，避免 atOptions 互相覆盖。
 * 环境变量为空则不输出；已配置广告自动加载，与 GA 的同意选择独立。
 * 隐藏或容不下原尺寸的广告不请求，原生广告高度随素材调整。
 * sandbox 限制顶层跳转，但同源且允许脚本，并非恶意素材的安全边界。
 */
import { currentSharedStrings } from '~/lib/shared-ui';

interface Props {
  name: string;
  width: number;
  height: number;
  label?: boolean;
  hideOnMobile?: boolean;
  compact?: boolean;
  /** 正文广告在加载前移动到指定的直接段落之后，不改写 MDX。 */
  afterParagraph?: number;
}
const {
  name,
  width,
  height,
  label = true,
  hideOnMobile = false,
  compact = false,
  afterParagraph,
} = Astro.props;
const envKey = `PUBLIC_ADSTERRA_SLOT_${name.replace(/-/g, '_').toUpperCase()}`;
const show = !!import.meta.env[envKey];
const isNative = name === 'native-banner';
const adLabel = currentSharedStrings(Astro.currentLocale).adLabel ?? 'Advertisement';
---
{
  show && (
    <div
      data-adsterra-slot={name}
      data-adsterra-after-paragraph={afterParagraph}
      data-pagefind-ignore
      class:list={[
        'w-full flex-col items-center justify-center not-prose',
        !compact && 'my-8',
        hideOnMobile ? (width >= 728 ? 'hidden lg:flex' : 'hidden md:flex') : 'flex',
      ]}
    >
      {label && (
        <span class="mb-1 text-[10px] uppercase tracking-wider text-muted-foreground">{adLabel}</span>
      )}
      <iframe
        data-src={`/ads/${name}.html`}
        data-adsterra-defer="1"
        data-adsterra-native={isNative ? '1' : undefined}
        data-adsterra-min-width={isNative ? 0 : width}
        style={`width:100%;max-width:${width}px;height:${height}px;border:0`}
        loading="lazy"
        sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
        title={adLabel}
      />
    </div>
  )
}
{
  show && (
    <script is:inline>
      // 原样交付浏览器，保持 ES2018 语法；全页只安装一组监听。
      (function () {
        if (window.__awAdsterraReady) return;
        window.__awAdsterraReady = true;
        var activate = function () {
          var pending = document.querySelectorAll('iframe[data-adsterra-defer]');
          for (var i = 0; i < pending.length; i++) {
            var frame = pending[i];
            var rect = frame.getBoundingClientRect();
            var minimumWidth = Number(frame.getAttribute('data-adsterra-min-width'));
            if (rect.height === 0 || rect.width + 0.5 < minimumWidth) continue;
            var src = frame.getAttribute('data-src');
            if (src) frame.src = src;
            frame.removeAttribute('data-adsterra-defer');
            frame.removeAttribute('data-src');
          }
        };
        var wire = function () {
          // 先放置正文广告，再加载 iframe，避免移动已加载节点造成重复请求。
          var inserts = document.querySelectorAll('[data-adsterra-after-paragraph]');
          var body = document.querySelector('[data-pagefind-body]');
          for (var i = 0; body && i < inserts.length; i++) {
            var paragraphs = [];
            for (var j = 0; j < body.children.length; j++) {
              if (body.children[j].tagName === 'P') paragraphs.push(body.children[j]);
            }
            var index = Number(inserts[i].getAttribute('data-adsterra-after-paragraph')) - 1;
            var target = paragraphs[index];
            if (target) target.insertAdjacentElement('afterend', inserts[i].parentElement);
          }
          var nativeFrames = document.querySelectorAll('iframe[data-adsterra-native]');
          for (var n = 0; n < nativeFrames.length; n++) {
            (function (frame) {
              frame.addEventListener('load', function () {
                var doc = frame.contentDocument;
                var container = doc && doc.querySelector('[id^="container-"]');
                if (!container) return;
                var resize = function () {
                  var height = Math.ceil(container.getBoundingClientRect().height);
                  if (height > 0) frame.style.height = height + 'px';
                };
                if (typeof ResizeObserver !== 'undefined') new ResizeObserver(resize).observe(container);
                resize();
              });
            })(nativeFrames[n]);
          }
          activate();
          window.addEventListener('resize', activate);
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', wire);
        else wire();
      })();
    </script>
  )
}

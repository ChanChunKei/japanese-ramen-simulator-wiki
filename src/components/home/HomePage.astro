---
/** 首页模块与全部文案由当前语言的 home JSON 驱动。 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import VideoSection from '~/components/home/VideoSection.astro';
import QuickStart from '~/components/home/QuickStart.astro';
import ExploreModules from '~/components/home/ExploreModules.astro';
import FaqSection from '~/components/home/FaqSection.astro';
import ScreenshotStrip from '~/components/home/ScreenshotStrip.astro';
import ArticleCover from '~/components/article/ArticleCover.astro';
import AdsterraSlot from '~/components/ads/AdsterraSlot.astro';
import { site } from '~/config/site';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { type Locale } from '~/i18n/routing';
import { getUi, type HomeUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId } from '~/lib/content';
import { localizePath, listPath, detailPath } from '~/lib/url';
import '~/styles/editorial.css';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
const home = ui.home;
const shared = ui.shared;
const recent = await getRecentEntries(locale, 6);
const meta = {
  title: home.meta?.title ?? site.name,
  description: home.meta?.description ?? site.description,
};
const hero: HomeUi['hero'] = home.hero;
const updates: HomeUi['updates'] = home.updates;
const start: HomeUi['start'] = home.start;
const popular: HomeUi['popular'] = home.popular;
const explore: HomeUi['explore'] = home.explore;
const closingCta: HomeUi['closingCta'] = home.closingCta;
const faq: HomeUi['faq'] = home.faq;
const screenshots: HomeUi['screenshots'] = home.screenshots;
const videoId = 'videoId' in hero && typeof hero.videoId === 'string' ? hero.videoId : '';
const browseHref = listPath(NAVIGATION_CONFIG[1]?.key ?? 'guides', locale);
const secondaryHref = hero.ctaSecondaryHref
  ? localizePath(hero.ctaSecondaryHref, locale)
  : browseHref;
function resolveHref(href: string): string {
  return /^https?:\/\//i.test(href) ? href : localizePath(href, locale);
}
const closingPrimaryHref = closingCta.primaryHref
  ? resolveHref(closingCta.primaryHref)
  : site.social.official;
const closingSecondaryHref = closingCta.secondaryHref
  ? resolveHref(closingCta.secondaryHref)
  : site.social.discord;
function externalLinkProps(href: string) {
  return /^https?:\/\//i.test(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {};
}

// 此模块展示编辑精选入口，不根据未经记录的访问量推断热度。
type QuickLink = string | { label: string; href: string };
const quickLinks: QuickLink[] = Array.isArray(popular.quickLinks) ? popular.quickLinks : [];
function quickLinkHref(link: QuickLink): string | null {
  return typeof link === 'string' ? null : localizePath(link.href, locale);
}
function quickLinkLabel(link: QuickLink): string {
  return typeof link === 'string' ? link : link.label;
}
function categoryLabel(category: string): string {
  return ui.nav[category as keyof typeof ui.nav] ?? category;
}
const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<LocaleLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <div class="editorial-home">
    <section class="editorial-hero">
      <div class="editorial-hero-copy">
        <p class="editorial-eyebrow">{hero.badge}</p>
        <h1 class="editorial-title">{hero.title}</h1>
        <p class="editorial-description">{hero.description}</p>
        <div class="editorial-hero-actions">
          {
            hero.ctaPrimary && site.social.official && (
              <a
                href={site.social.official}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary"
              >
                <Icon name="lucide:play" class="mr-2 h-4 w-4" />
                {hero.ctaPrimary}
              </a>
            )
          }
          {
            hero.ctaSecondary && (
              <a href={secondaryHref} class="btn-outline">
                {hero.ctaSecondary}
                <Icon name="lucide:arrow-right" class="ml-2 h-4 w-4" />
              </a>
            )
          }
        </div>
        {
          hero.featuredLink?.label && hero.featuredLink.href && (
            <a href={localizePath(hero.featuredLink.href, locale)} class="editorial-featured-link">
              <Icon name="lucide:clock-3" class="mt-0.5 h-4 w-4 shrink-0" />
              <span>{hero.featuredLink.label}</span>
            </a>
          )
        }
      </div>
      {
        hero.illustration?.src && (
          <figure class="editorial-hero-art">
            <img
              src={hero.illustration.src}
              srcset={hero.illustration.srcset}
              sizes="(max-width: 768px) calc(100vw - 32px), 45vw"
              alt={hero.illustration.alt}
              width={hero.illustration.width}
              height={hero.illustration.height}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            {hero.illustration.caption && (
              <figcaption class="editorial-art-caption">
                {hero.illustration.caption}
                <a href={hero.illustration.sourceHref} target="_blank" rel="noopener noreferrer">
                  {hero.illustration.sourceLabel}
                </a>
              </figcaption>
            )}
          </figure>
        )
      }
    </section>

    <ScreenshotStrip
      title={screenshots.title}
      description={screenshots.description}
      sourceHref={screenshots.sourceHref}
      sourceLabel={screenshots.sourceLabel}
      items={screenshots.items.map((item) => ({ ...item, href: localizePath(item.href, locale) }))}
    />

    {
      videoId && (
        <VideoSection videoId={videoId} title={`${site.game.name} ${shared.gameTrailer}`} />
      )
    }

    <QuickStart locale={locale} badge={start.badge} title={start.title} cards={start.cards} />

    <section class="section border-t border-border">
      <div class="editorial-updates">
        <div>
          <div class="editorial-section-heading">
            <h2>{updates.title}</h2>
            <a href={browseHref} class="text-sm text-nav hover:underline">{shared.browseAll}</a>
          </div>
          <div class="editorial-recent-grid">
            {
              recent.length === 0 ? (
                <p class="text-sm text-muted-foreground">{shared.noArticles}</p>
              ) : (
                recent.map((entry) => {
                  const parsed = parseEntryId(entry.id);
                  if (!parsed) return null;
                  const modified = entry.data.lastModified ?? entry.data.date;
                  return (
                    <a
                      href={detailPath(parsed.category, parsed.slug, locale)}
                      class="editorial-recent-link"
                    >
                      {entry.data.image && (
                        <ArticleCover
                          src={entry.data.image}
                          alt={entry.data.title}
                          class="mb-4 aspect-video w-full rounded-sm object-cover"
                        />
                      )}
                      <span class="editorial-recent-category">
                        {categoryLabel(parsed.category)}
                      </span>
                      <h3>{entry.data.title}</h3>
                      <p class="line-clamp-2">{entry.data.description}</p>
                      <time datetime={modified.toISOString()}>
                        {shared.lastUpdated}: {dateFormatter.format(modified)}
                      </time>
                    </a>
                  );
                })
              )
            }
          </div>
        </div>

        {
          quickLinks.length > 0 && (
            <aside class="editorial-links-panel">
              <p class="editorial-eyebrow">{popular.badge}</p>
              <h2>{popular.title}</h2>
              <ul>
                {quickLinks.map((link) => {
                  const href = quickLinkHref(link);
                  const label = quickLinkLabel(link);
                  return (
                    <li>
                      {href ? (
                        <a href={href} class="editorial-quick-link">
                          <span>{label}</span>
                          <Icon name="lucide:arrow-up-right" class="h-4 w-4 shrink-0 text-nav" />
                        </a>
                      ) : (
                        <span class="editorial-quick-link">{label}</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </aside>
          )
        }
      </div>
    </section>

    {
      explore.modules?.length > 0 && (
        <section class="section border-t border-border">
          <div class="editorial-section-heading">
            <h2>{explore.title}</h2>
          </div>
          <p class="mt-3 max-w-2xl text-sm text-muted-foreground">{explore.description}</p>
          <div class="mt-8">
            <ExploreModules modules={explore.modules} locale={locale} />
          </div>
        </section>
      )
    }

    <AdsterraSlot name="native-banner" width={700} height={240} />

    {
      faq.items.length > 0 && (
        <div class="editorial-faq">
          <FaqSection
            title={faq.title}
            description={faq.description}
            items={faq.items}
            headingLevel="h2"
          />
        </div>
      )
    }

    {
      closingCta.title && (
        <section class="section editorial-closing border-t border-border">
          <div class="editorial-closing-inner">
            <h2>{closingCta.title}</h2>
            <p>{closingCta.description}</p>
            <div class="editorial-closing-actions">
              {closingCta.primary && closingPrimaryHref && (
                <a
                  href={closingPrimaryHref}
                  {...externalLinkProps(closingPrimaryHref)}
                  class="btn-primary"
                >
                  {closingCta.primary}
                </a>
              )}
              {closingCta.secondary && closingSecondaryHref && (
                <a
                  href={closingSecondaryHref}
                  {...externalLinkProps(closingSecondaryHref)}
                  class="btn-outline"
                >
                  {closingCta.secondary}
                </a>
              )}
            </div>
          </div>
        </section>
      )
    }
  </div>
</LocaleLayout>

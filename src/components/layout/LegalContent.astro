---
/** 法律页共享正文；本站介绍、联系与版权文案由英文 legal JSON 驱动。 */
import { site } from '~/config/site';
import { getUi } from '~/i18n/ui';
import '~/styles/editorial.css';

interface Props {
  page: 'about' | 'privacy-policy' | 'terms-of-service' | 'copyright' | 'contact';
}
const { page } = Astro.props;
const game = site.game.name;
const year = new Date().getFullYear();
const legal = getUi('en').legal;
// 配置中的仓库属于本站；游戏开发商的社交渠道不作为本站联系地址。
const repositoryIssues = site.repositoryUrl
  ? `${site.repositoryUrl.replace(/\/+$/, '').replace(/\.git$/, '')}/issues`
  : undefined;
const substitutions: Record<string, string> = {
  siteName: site.name,
  gameName: game,
  developer: site.game.developer,
  platform: site.game.platform,
  genre: site.game.genre,
  year: String(year),
};
function format(text: string): string {
  return text.replace(/\{(\w+)\}/g, (match, key: string) => substitutions[key] ?? match);
}
---

{
  page === 'about' && (
    <>
      <p>{format(legal.about.introduction)}</p>
      {legal.about.sections.map((section) => (
        <>
          <h2>{format(section.title)}</h2>
          {section.body && <p>{format(section.body)}</p>}
          {section.items.length > 0 && (
            <ul>
              {section.items.map((item) => (
                <li>{format(item)}</li>
              ))}
            </ul>
          )}
        </>
      ))}
      <h2>{legal.about.contactTitle}</h2>
      <p>{format(legal.about.contactDescription)}</p>
      {repositoryIssues || site.contactEmail ? (
        <ul>
          {repositoryIssues && (
            <li>
              <a href={repositoryIssues} target="_blank" rel="noopener noreferrer">
                {legal.shared.repositoryLabel}
              </a>
            </li>
          )}
          {site.contactEmail && (
            <li>
              <a href={`mailto:${site.contactEmail}`}>
                {legal.shared.emailLabel}: {site.contactEmail}
              </a>
            </li>
          )}
        </ul>
      ) : (
        <p>{legal.shared.unavailable}</p>
      )}
    </>
  )
}

{
  page === 'privacy-policy' && (
    <>
      <p>{format(legal.privacy.introduction)}</p>
      {legal.privacy.sections.map((section) => (
        <>
          <h2>{format(section.title)}</h2>
          {section.body && <p>{format(section.body)}</p>}
          {section.items.length > 0 && (
            <ul>
              {section.items.map((item) => (
                <li>{format(item)}</li>
              ))}
            </ul>
          )}
        </>
      ))}
    </>
  )
}

{
  page === 'terms-of-service' && (
    <>
      <p>By accessing {site.name}, you agree to the following terms of service.</p>
      <h2>Use of Content</h2>
      <p>
        All guides, articles, and reference material on this site are provided for personal,
        non-commercial use. You may not copy, republish, or redistribute our content without
        attribution and a link back to the original page.
      </p>
      <h2>Accuracy</h2>
      <p>
        We strive for accuracy but make no warranties regarding the completeness or correctness of
        any content. {game} is frequently updated, and information may become outdated. Always
        verify critical information in-game.
      </p>
      <h2>Third-Party Links</h2>
      <p>
        This site links to external websites (official game channels, video tutorials, etc.) that we
        do not control. We are not responsible for the content or practices of third-party sites.
      </p>
      <h2>Trademarks</h2>
      <p>
        {game} and all related trademarks, logos, and assets are the property of{' '}
        {site.game.developer}. {site.name} is an independent fan project and is not affiliated with
        or endorsed by {site.game.developer}.
      </p>
      <h2>Limitation of Liability</h2>
      <p>
        Use of this site is at your own risk. We are not liable for any damages arising from your
        use of the site or reliance on its content.
      </p>
      <h2>Changes to These Terms</h2>
      <p>
        We may revise these terms at any time. Continued use of the site after changes constitutes
        acceptance of the updated terms.
      </p>
    </>
  )
}

{
  page === 'copyright' && (
    <>
      <h2>{legal.copyright.noticeTitle}</h2>
      <p>{format(legal.copyright.notice)}</p>
      <h2>{legal.copyright.assetsTitle}</h2>
      <p>{format(legal.copyright.assets)}</p>
      <h2>{legal.copyright.takedownTitle}</h2>
      <p>{format(legal.copyright.takedown)}</p>
      {repositoryIssues || site.contactEmail ? (
        <ul>
          {repositoryIssues && (
            <li>
              <a href={repositoryIssues} target="_blank" rel="noopener noreferrer">
                {legal.shared.repositoryLabel}
              </a>
            </li>
          )}
          {site.contactEmail && (
            <li>
              <a href={`mailto:${site.contactEmail}`}>
                {legal.shared.emailLabel}: {site.contactEmail}
              </a>
            </li>
          )}
        </ul>
      ) : (
        <p>{legal.shared.unavailable}</p>
      )}
      <p>
        <a href="/contact/">{legal.copyright.takedownLinkLabel}</a>
      </p>
      <h2>{legal.copyright.fanTitle}</h2>
      <p>{site.legalNotice}</p>
    </>
  )
}

{
  page === 'contact' && (
    <>
      {/* 页面布局已经输出 H1；正文从 H2 开始。 */}
      <h2>{format(legal.contact.title)}</h2>
      <p>{format(legal.contact.introduction)}</p>
      <h2>{legal.contact.channelsTitle}</h2>
      {repositoryIssues || site.contactEmail ? (
        <ul>
          {repositoryIssues && (
            <li>
              <a href={repositoryIssues} target="_blank" rel="noopener noreferrer">
                {legal.contact.repositoryLabel}
              </a>
            </li>
          )}
          {site.contactEmail && (
            <li>
              <a href={`mailto:${site.contactEmail}`}>
                {legal.contact.emailLabel}: {site.contactEmail}
              </a>
            </li>
          )}
        </ul>
      ) : (
        <p>{legal.contact.unavailable}</p>
      )}
      <h2>{legal.contact.contributingTitle}</h2>
      <p>{format(legal.contact.contributingDescription)}</p>
      <h2>{legal.contact.reportingTitle}</h2>
      <p>{format(legal.contact.reportingDescription)}</p>
      <p>
        <a href="/copyright/">{legal.contact.copyrightLinkLabel}</a>
      </p>
    </>
  )
}

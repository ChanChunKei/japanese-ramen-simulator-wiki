---
/** 正文插图复用Astro图片优化；说明和来源由文章提供。 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  sourceHref?: string;
  sourceLabel?: string;
}
const { src, alt, caption, sourceHref, sourceLabel } = Astro.props;
---

<figure class="guide-figure not-prose">
  <a href={src.src} target="_blank" rel="noopener noreferrer" aria-label={alt}>
    {
      src.format === 'svg' ? (
        <img
          src={src.src}
          alt={alt}
          width={src.width}
          height={src.height}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <Image
          src={src}
          alt={alt}
          width={1200}
          height={675}
          widths={[480, 800, 1200]}
          sizes="(max-width: 768px) calc(100vw - 32px), (max-width: 1280px) 65vw, 780px"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </a>
  <figcaption>
    <span>{caption}</span>
    {
      sourceHref && sourceLabel && (
        <a href={sourceHref} target="_blank" rel="noopener noreferrer">
          {sourceLabel}
        </a>
      )
    }
  </figcaption>
</figure>

<style>
  .guide-figure {
    margin: 2rem 0;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    background: hsl(var(--card));
  }
  .guide-figure > a {
    display: block;
  }
  .guide-figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    margin: 0;
  }
  .guide-figure figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    border-top: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .guide-figure figcaption span {
    flex: 1 1 18rem;
  }
  .guide-figure figcaption a {
    align-self: flex-start;
    color: hsl(var(--brand-text));
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
